rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isClinic() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'clinic';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /tradeIns/{tradeInId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.donorId;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.donorId || isClinic());
      allow update: if isClinic();
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.status == 'upcoming';
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }

    match /bookingSlots/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    match /coupons/{couponId} {
      allow create: if isClinic();
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.donorId || isClinic());
      allow update: if isClinic();
      allow delete: if false;
    }
  }
}
